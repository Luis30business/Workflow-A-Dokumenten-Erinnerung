        "jsCode": "const dokumente = ['Ausweis', 'Gehaltsnachweis', 'Kontoauszug', 'Steuerbescheid', 'Eigenkapitalnachweis'];\nconst fehlende = [];\n\nfor (const name of dokumente) {\n  if ($json[name] !== 'erhalten') {\n    fehlende.push(name);\n  }\n}\n\n$input.item.json.fehlende_dokumente = fehlende;\n$input.item.json.anzahl_fehlend = fehlende.length;\n\nreturn $input.item"
